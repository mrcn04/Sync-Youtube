{
  "name": "sync-youtube",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Watch YouTube together with shared controls and live chat",
  "author": "\u00d6m\u00fcrcan Cengiz",
  "license": "ISC",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client \"tsx watch server/src/index.ts\" \"vite --config client/vite.config.ts\"",
    "build": "npm run typecheck && vite build --config client/vite.config.ts && tsc -p server/tsconfig.json",
    "typecheck": "tsc -p client/tsconfig.json && tsc -p server/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node server/dist/server/src/index.js",
    "heroku-postbuild": "npm run build"
  },
  "dependencies": {
    "express": "5.3.0",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "vite": "8.3.8",
    "@vitejs/plugin-react": "6.3.0",
    "typescript": "7.0.2",
    "vitest": "5.1.1",
    "tsx": "4.23.15",
    "concurrently": "10.0.7",
    "@types/node": "26.6.6",
    "@types/express": "5.0.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
